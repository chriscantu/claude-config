{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(**/credentials/**)",
      "Edit(~/.claude/DISABLE_SECRET_GUARD)",
      "Edit(~/.claude/settings.json)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true
  }
}
